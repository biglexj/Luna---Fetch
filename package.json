{
  "name": "luna-fetch",
  "version": "1.2.0",
  "description": "Luna Fetch — Descargador multiplataforma de video y audio de alta calidad para Windows y Android",
  "private": true,
  "scripts": {
    "dev": "cmd /c gradlew.bat :composeApp:run",
    "dev:desktop": "cmd /c gradlew.bat :composeApp:run",
    "dev:android": "cmd /c gradlew.bat :composeApp:installDebug",
    "test": "cmd /c gradlew.bat :composeApp:desktopTest",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build/build-release.ps1 -LocalOnly",
    "build:app": "cmd /c gradlew.bat :composeApp:packageExe",
    "build:desktop": "cmd /c gradlew.bat :composeApp:packageExe",
    "build:android": "cmd /c gradlew.bat :composeApp:assembleRelease",
    "build:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build/build-release.ps1 -LocalOnly",
    "release:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build/build-release.ps1 -LocalOnly",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build/build-release.ps1 -SkipAndroid -LocalOnly",
    "release:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build/build-release.ps1 -SkipWindows -LocalOnly",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build/build-release.ps1",
    "release:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build/build-release.ps1"
  },
  "keywords": [
    "downloader",
    "video",
    "audio",
    "yt-dlp",
    "compose-multiplatform",
    "kotlin-multiplatform",
    "android",
    "desktop"
  ],
  "author": "biglexj (2026)",
  "license": "MIT"
}
